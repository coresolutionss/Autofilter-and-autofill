# Paste these root-level settings into Streamlit Community Cloud > Advanced settings > Secrets.
EXTRACTION_PROVIDER = "groq"
GROQ_VISION_MODEL = "qwen/qwen3.8-27b"
GROQ_API_KEY = "replace-with-your-groq-key"
DIGISIGNER_API_KEY = "replace-with-your-digisigner-key"
# Optional development-only default signer; leave empty for production.
DIGISIGNER_TEST_EMAIL = ""
